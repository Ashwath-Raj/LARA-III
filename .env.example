# Optional local provider settings. Replace the placeholder only in your ignored .env.
GEMINI_API_KEY=replace-with-your-key

# Deployment defaults remain protected; the local launcher explicitly overrides
# these values with loopback-only demo settings.
LARA_LOCAL_DEMO=0
LARA_PUBLIC_ORIGIN=https://lara.example.invalid

# Optional local inference/memory configuration.
OLLAMA_MODEL=gemma4:e2b-it-q4_K_M
OLLAMA_TIMEOUT_SECONDS=30
UBUNTU_AGENT_OLLAMA_URL=http://127.0.0.1:11434
UBUNTU_AGENT_EMBEDDING_MODEL=embeddinggemma
